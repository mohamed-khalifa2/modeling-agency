# Project URL: Supabase Dashboard -> Connect dialog (or Project Settings -> Data API)
# Looks like: https://<project-ref>.supabase.co — the project ref is your "project id"
NEXT_PUBLIC_SUPABASE_URL=your-project-url

# Publishable API key: Supabase Dashboard -> Connect dialog or Settings -> API Keys
# Replaces the deprecated anon key (retired by end of 2026). Format: sb_publishable_...
# Never use the secret key (sb_secret_...) here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Canonical site URL, no trailing slash. Used for metadataBase, Open Graph,
# sitemap.xml, and robots.txt. Set this to your production domain on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
